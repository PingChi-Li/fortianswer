# Azure Function chat API base URL (no trailing slash).
# Defaults to production if not set.
# VITE_API_BASE_URL=https://func-fortianswer-gccvakhgayenbdak.canadacentral-01.azurewebsites.net

# For local development with a proxy:
# VITE_API_BASE_URL=http://localhost:3000

# Show debug UI (brown area with Azure response attributes). Default: hidden.
# VITE_SHOW_DEBUG=false

# Key for X-Debug-Key header when fetching /api/debug/{requestId}. Dev/internal use only.
# VITE_DEBUG_VIEW_KEY=dev-only-123
